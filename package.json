{
  "name": "build-strap",
  "version": "0.0.0",
  "description": "Node scripts for building things",
  "license": "MIT",
  "author": "Justin Murray <justin@murrayju.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/murrayju/build-strap"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  },
  "buildStrap": {
    "repoType": "git",
    "copyright": "Justin Murray",
    "mainBranch": "main",
    "npm": {
      "publish": true,
      "registry": "https://registry.npmjs.org/"
    },
    "docker": {
      "repository": "murrayju",
      "registry": "ghcr.io"
    }
  },
  "dependencies": {
    "bytes": "^3.1.1",
    "chokidar": "^6.0.0",
    "cross-spawn": "^7.0.3",
    "fs-extra": "^11.4.1",
    "get-port": "^7.1.0",
    "glob": "^14.0.4",
    "is-reachable": "^6.1.0",
    "js-yaml": "^5.5.0",
    "rimraf": "^6.1.4",
    "semver": "^7.8.6",
    "tar": "^7.1.0"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/bytes": "^3.1.4",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  }
}
