{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      ["builtin", "external"],
      "parent",
      "sibling",
      "index",
      "unknown"
    ],
    "ignoreCase": true,
    "newlinesBetween": true,
    "order": "asc"
  },
  "sortPackageJson": false,
  "trailingComma": "all"
}
